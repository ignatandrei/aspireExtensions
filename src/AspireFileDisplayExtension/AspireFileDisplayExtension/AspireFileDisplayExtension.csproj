<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- NuGet package metadata -->
		<PackageId>AspireFileDisplayExtension</PackageId>
		<Version>134.2026.809.1615</Version>
		<Authors>Ignat Andrei</Authors>
		<Company>AOM</Company>
		<RepositoryType>git</RepositoryType>
		<Description>Added resource for show files</Description>
		<PackageTags>aspire;extensions;distributed;package.json;javascript;integrations;hosting</PackageTags>
		<RepositoryUrl>https://github.com/ignatandrei/aspireExtensions</RepositoryUrl>
		<PackageProjectUrl>https://github.com/ignatandrei/aspireExtensions/tree/main/src/JavaScriptExtensionsAspire</PackageProjectUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<IsPackable>true</IsPackable>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>


	</PropertyGroup>
	<ItemGroup>
		<Content Include="..\LICENSE" Link="LICENSE" PackagePath="/">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="..\README.md" Link="README.md" PackagePath="/">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>

	</ItemGroup>
	<ItemGroup>
		<EmbeddedResource Include="vs\**">
			<!-- Force the manifest resource name to be the literal relative path with
				 '\' turned into '.', so EmbeddedFileProvider (which does the same
				 transformation on the request path) can resolve every file, including
				 ones under folders that contain '.' or '-' (which MSBuild would
				 otherwise mangle into '_'). -->
			<LogicalName>$([System.String]::Copy('%(RelativeDir)').Replace('\','.'))%(Filename)%(Extension)</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Aspire.Hosting" Version="13.4.6" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.400" PrivateAssets="All" />
		<PackageReference Include="RazorBlade" Version="1.0.0" ExcludeAssets="compile;runtime" PrivateAssets="all" />
	</ItemGroup>

</Project>
