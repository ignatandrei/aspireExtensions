@inherits RazorBlade.PlainTextTemplate<AspireFileDisplayExtension.FileToDisplay>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<title>Monaco C# Viewer</title>
<style>
  html, body { margin: 0; padding: 0; height: 100%; }
  #container { width: 100%; height: 100vh; }

  /* Bigger font for specific decorated lines */
  .big-line {
    font-size: 22px !important;
  }
  .big-line-margin {
    background: rgba(255, 215, 0, 0.15);
  }
</style>
</head>
<body>
  This is the code from the C# file:
<div id="container"></div>

<script src="/vs/loader.js"></script>
<script>
  require.config({ paths: { vs: '/vs' } });

  const csharpCode = `using System;

namespace HelloWorld
{
    public class Program
    {
        public static void Main(string[] args)
        {
            Console.WriteLine("Hello, World!");

            var numbers = new[] { 1, 2, 3, 4, 5 };
            int sum = 0;
            foreach (var n in numbers)
            {
                sum += n;
            }

            Console.WriteLine($"Sum: {sum}");
        }
    }
}
`;

  require(['/vs/editor/editor.main'], function () {
    const editor = monaco.editor.create(document.getElementById('container'), {
      value: csharpCode,
      language: 'csharp',
      theme: 'vs-dark',
      automaticLayout: true,
      readOnly: true,
      minimap: { enabled: true },
      lineNumbers: 'on',
      lineNumbersMinChars: 3,
      bracketPairColorization: { enabled: true },
      links: true
    });

    // Increase font size on specific lines (e.g. line 8 and line 21)
    editor.createDecorationsCollection([
      {
        range: new monaco.Range(9, 1, 9, 1),
        options: {
          isWholeLine: true,
          inlineClassName: 'big-line',
          marginClassName: 'big-line-margin'
        }
      },
      {
        range: new monaco.Range(21, 1, 21, 1),
        options: {
          isWholeLine: true,
          inlineClassName: 'big-line',
          marginClassName: 'big-line-margin'
        }
      }
    ]);
  });
</script>
</body>
</html>

