@inherits RazorBlade.PlainTextTemplate<AspireFileDisplayExtension.FileToDisplay>
@using System.Text.Json
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<title>Monaco Viewer - @Model.NameFile()</title>
<style>
  html, body { margin: 0; padding: 0; height: 100%; }
  #container { width: 100%; height: 100vh; }
</style>
</head>
<body>
This is the file @Model.NameFile() with the language @Model.MonacoLanguageId()
 <div id="container"></div>

<script src="/vs/loader.js"></script>
<script>
  require.config({ paths: { vs: '/vs' } });

  const fileContent = @(JsonSerializer.Serialize(Model.ReadContent()));
  const languageId  = @(JsonSerializer.Serialize(Model.MonacoLanguageId()));

  require(['vs/editor/editor.main'], function () {
    monaco.editor.create(document.getElementById('container'), {
      value: fileContent,
      language: languageId,
      theme: 'vs-dark',
      automaticLayout: true,
      readOnly: true,
      minimap: { enabled: true },
      lineNumbers: 'on',
      lineNumbersMinChars: 3,
      bracketPairColorization: { enabled: true },
      links: true
    });
  });
</script>
</body>
</html>

