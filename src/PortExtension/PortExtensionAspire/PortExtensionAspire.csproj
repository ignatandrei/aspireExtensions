<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- NuGet package metadata -->
		<PackageId>PortExtensionsAspire</PackageId>
		<Version>131.2026.809.1615</Version>
		<Authors>Ignat Andrei</Authors>
		<Company>AOM</Company>
		<RepositoryType>git</RepositoryType>
		<Description>Adding determinate ports for resources</Description>
		<PackageTags>aspire;extensions;distributed;package.json;javascript;integrations;hosting</PackageTags>
		<RepositoryUrl>https://github.com/ignatandrei/aspireExtensions</RepositoryUrl>
		<PackageProjectUrl>https://github.com/ignatandrei/aspireExtensions/tree/main/src/JavaScriptExtensionsAspire</PackageProjectUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<IsPackable>true</IsPackable>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>


	</PropertyGroup>
	<ItemGroup>
		<Content Include="..\LICENSE" Link="LICENSE" PackagePath="/">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="..\README.md" Link="README.md" PackagePath="/">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>

	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.301" PrivateAssets="All" />
		<PackageReference Include="CommunityToolkit.Aspire.Hosting.Sqlite" Version="13.4.0" />
	</ItemGroup>

</Project>
